# Copy to Scripts/signing.env (gitignored) and fill in. Every value is optional.
#
# Sourced by Scripts/make-dmg.sh. Environment variables set on the command line
# win, because signing.env only fills in what is not already set.

# Leave unset to let the script pick the first Developer ID Application
# certificate in the keychain, falling back to an ad-hoc signature.
# SIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Requires SIGN_IDENTITY to be a Developer ID Application certificate.
# NOTARIZE=1

# Keychain profile holding the App Store Connect credentials, created once with:
#   xcrun notarytool store-credentials wallpache \
#     --apple-id you@example.com --team-id TEAMID --password <app-specific-password>
# NOTARY_PROFILE="wallpache"
