<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Wallpache.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="480"
             x:Class="Wallpache.App.Views.LibraryView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <!-- The per-display "apply here" menu is built by binding rather than by
             a click handler per item, so it follows display changes on its own. -->
        <ControlTheme x:Key="DisplayTargetMenuItemTheme"
                      TargetType="MenuItem"
                      BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="vm:DisplayTargetViewModel">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding ApplyCommand}" />
        </ControlTheme>
    </UserControl.Resources>

    <Grid RowDefinitions="*,Auto,Auto">

        <!-- Empty state -->
        <StackPanel Grid.Row="0"
                    IsVisible="{Binding IsLibraryEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    MaxWidth="360">
            <Image Source="avares://Wallpache/Assets/brand-mark.png"
                   Width="76"
                   Height="76"
                   Opacity="0.9" />
            <TextBlock Text="No wallpapers yet"
                       FontSize="18"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Drag an .mp4, .mov, or .m4v video here, or use Import Video."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Grid of imported wallpapers -->
        <ScrollViewer Grid.Row="0" IsVisible="{Binding !IsLibraryEmpty}">
            <ItemsControl ItemsSource="{Binding LibraryItems}" Margin="16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WallpaperItemViewModel">
                        <Border Width="272"
                                Margin="0,0,16,16"
                                Padding="12"
                                ClipToBounds="True"
                                Classes="card">
                            <StackPanel Spacing="8">
                                <!-- A Panel, not a nested child of the thumbnail: the "…"
                                     button overlays the thumbnail's top-right corner but is
                                     a sibling of it, not inside its ClipToBounds, so the
                                     thumbnail's rounded-corner clip can never eat part of the
                                     button's hit-test area. Moving "…" here (off the action
                                     row below) also means that row never has to fit four
                                     buttons in the card's fixed width, which is what silently
                                     clipped - and made unclickable - part of a wider "…". -->
                                <Panel>
                                    <Border CornerRadius="10"
                                            ClipToBounds="True"
                                            Height="152"
                                            Background="{DynamicResource ControlAltFillColorTertiaryBrush}">
                                        <Panel>
                                            <TextBlock Text="🎞"
                                                       FontSize="26"
                                                       Opacity="0.45"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>

                                    <!-- Rename and delete are also in the context menu, but a
                                         right-click-only action is easy to miss. -->
                                    <Button Content="⋯"
                                            Classes="icon-circle on-image"
                                            Margin="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="More actions">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Rename…" Click="OnRename" />
                                                <Separator />
                                                <MenuItem Header="Delete…" Click="OnDelete" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Panel>

                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12"
                                           Opacity="0.7" />

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Apply" Classes="pill-action emphasized" Click="OnApply" />
                                    <Button Content="Preview" Classes="pill-action emphasized" Click="OnPreview" />

                                    <Button Content="Display ⌄"
                                            Classes="pill-action"
                                            IsEnabled="{Binding CanChooseDisplay}">
                                        <Button.Flyout>
                                            <MenuFlyout ItemsSource="{Binding DisplayTargets}"
                                                        ItemContainerTheme="{StaticResource DisplayTargetMenuItemTheme}" />
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Preview…" Click="OnPreview" />
                                    <MenuItem Header="Apply to All Displays" Click="OnApply" />
                                    <MenuItem Header="Apply to Display"
                                              IsEnabled="{Binding CanChooseDisplay}"
                                              ItemsSource="{Binding DisplayTargets}"
                                              ItemContainerTheme="{StaticResource DisplayTargetMenuItemTheme}" />
                                    <Separator />
                                    <MenuItem Header="Rename…" Click="OnRename" />
                                    <MenuItem Header="Delete…" Click="OnDelete" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Separator Grid.Row="1" />

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12">
            <TextBlock Grid.Column="0"
                       Text="{Binding Coordinator.StatusMessage}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Opacity="0.7" />

            <ProgressBar Grid.Column="1"
                         IsIndeterminate="True"
                         Width="90"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         IsVisible="{Binding Coordinator.IsImporting}" />

            <!-- A standing reminder that this window accepts a dropped video,
                 not just an interactive drop target: the highlight below only
                 shows up mid-drag, which is too late for a first-time user to
                 discover the feature at all. Purely a label, so it does not
                 fight the real drop target for hit-testing. -->
            <Border Grid.Column="2"
                    Margin="0,0,10,0"
                    Padding="10,5"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource TabSwitcherBorderBrush}"
                    IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="📄" FontSize="12" Opacity="0.7" />
                    <TextBlock Text="Drop videos here" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </Border>

            <Button Grid.Column="3"
                    Content="Import Video…"
                    Classes="accent"
                    FontSize="12"
                    Click="OnImport"
                    IsEnabled="{Binding !Coordinator.IsImporting}" />
        </Grid>

        <!-- Drop target highlight -->
        <Border Grid.Row="0"
                x:Name="DropHighlight"
                IsVisible="False"
                IsHitTestVisible="False"
                Margin="8"
                CornerRadius="12"
                BorderThickness="3"
                BorderBrush="{StaticResource BrandWavePurpleBrush}" />

        <!-- Pending-import review: files are already copied and processed by
             this point, but held back from the library grid above until the
             user confirms them here, so a wrong drop or pick is still easy to
             back out of. -->
        <Border Grid.Row="0"
                IsVisible="{Binding HasPendingImports}"
                VerticalAlignment="Bottom"
                Margin="8"
                Padding="14"
                MaxHeight="300"
                CornerRadius="14"
                Background="{DynamicResource ElevatedPanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                BoxShadow="0 8 28 0 #80000000">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="{Binding PendingImportSummary}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Clear" FontSize="12" Click="OnClearPendingImports" />
                        <Button Content="{Binding PendingImportActionText}"
                                Classes="accent"
                                FontSize="12"
                                Click="OnCommitPendingImports" />
                    </StackPanel>
                </Grid>

                <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PendingImportItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WallpaperItemViewModel">
                                <Border Width="150" Margin="0,0,12,0" ClipToBounds="True">
                                    <StackPanel Spacing="6">
                                        <Panel>
                                            <Border CornerRadius="8"
                                                    ClipToBounds="True"
                                                    Height="88"
                                                    Background="{DynamicResource ControlAltFillColorTertiaryBrush}">
                                                <Panel>
                                                    <TextBlock Text="🎞"
                                                               FontSize="18"
                                                               Opacity="0.45"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Panel>
                                            </Border>

                                            <Button Content="✕"
                                                    Classes="icon-circle on-image"
                                                    Width="24"
                                                    Height="24"
                                                    FontSize="11"
                                                    Margin="4"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    Click="OnRemovePendingImport"
                                                    ToolTip.Tip="Remove" />
                                        </Panel>

                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Opacity="0.7" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
