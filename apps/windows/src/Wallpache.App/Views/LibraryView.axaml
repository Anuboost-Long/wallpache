<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Wallpache.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="480"
             x:Class="Wallpache.App.Views.LibraryView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <!-- The per-display "apply here" menu is built by binding rather than by
             a click handler per item, so it follows display changes on its own. -->
        <ControlTheme x:Key="DisplayTargetMenuItemTheme"
                      TargetType="MenuItem"
                      BasedOn="{StaticResource {x:Type MenuItem}}"
                      x:DataType="vm:DisplayTargetViewModel">
            <Setter Property="Header" Value="{Binding Name}" />
            <Setter Property="Command" Value="{Binding ApplyCommand}" />
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Dashed drop target beside the import button. Avalonia's Border has
             no dashed stroke, so the outline is a Rectangle behind the label. -->
        <Style Selector="Rectangle.drop-zone">
            <Setter Property="RadiusX" Value="8" />
            <Setter Property="RadiusY" Value="8" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeDashArray" Value="4,3" />
            <Setter Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <Style Selector="Rectangle.drop-zone.targeted">
            <Setter Property="Stroke" Value="{DynamicResource BrandWavePurpleBrush}" />
            <Setter Property="Fill" Value="#1F8A4CFF" />
        </Style>

        <!-- A staged file's duration and resolution, or the reason it cannot
             be imported, which reads as a warning rather than a detail. -->
        <Style Selector="TextBlock.staged-detail">
            <Setter Property="Opacity" Value="0.7" />
        </Style>

        <Style Selector="TextBlock.staged-detail.problem">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource BrandWaveOrangeBrush}" />
        </Style>

        <!-- Icon-circle at tray-card scale: a staged card is half a library
             tile, where the full-size affordance would cover the preview. -->
        <Style Selector="Button.icon-circle.compact">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="*,Auto,Auto,Auto">

        <!-- Empty state -->
        <StackPanel Grid.Row="0"
                    IsVisible="{Binding IsLibraryEmpty}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    MaxWidth="360">
            <Image Source="avares://Wallpache/Assets/brand-mark.png"
                   Width="76"
                   Height="76"
                   Opacity="0.9" />
            <TextBlock Text="No wallpapers yet"
                       FontSize="18"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Drag an .mp4, .mov, .m4v, or .gif here, or use Import Video."
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Opacity="0.7" />
        </StackPanel>

        <!-- Grid of imported wallpapers -->
        <ScrollViewer Grid.Row="0" IsVisible="{Binding !IsLibraryEmpty}">
            <ItemsControl ItemsSource="{Binding LibraryItems}" Margin="16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WallpaperItemViewModel">
                        <Border Width="272"
                                Margin="0,0,16,16"
                                Padding="12"
                                ClipToBounds="True"
                                Classes="card">
                            <StackPanel Spacing="8">
                                <!-- A Panel, not a nested child of the thumbnail: the "…"
                                     button overlays the thumbnail's top-right corner but is
                                     a sibling of it, not inside its ClipToBounds, so the
                                     thumbnail's rounded-corner clip can never eat part of the
                                     button's hit-test area. Moving "…" here (off the action
                                     row below) also means that row never has to fit four
                                     buttons in the card's fixed width, which is what silently
                                     clipped - and made unclickable - part of a wider "…". -->
                                <Panel>
                                    <Border CornerRadius="10"
                                            ClipToBounds="True"
                                            Height="152"
                                            Background="{DynamicResource ControlAltFillColorTertiaryBrush}">
                                        <Panel>
                                            <TextBlock Text="🎞"
                                                       FontSize="26"
                                                       Opacity="0.45"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                        </Panel>
                                    </Border>

                                    <!-- Rename and delete are also in the context menu, but a
                                         right-click-only action is easy to miss. -->
                                    <Button Content="⋯"
                                            Classes="icon-circle on-image"
                                            Margin="6"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            ToolTip.Tip="More actions">
                                        <Button.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Rename…" Click="OnRename" />
                                                <Separator />
                                                <MenuItem Header="Delete…" Click="OnDelete" />
                                            </MenuFlyout>
                                        </Button.Flyout>
                                    </Button>
                                </Panel>

                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}"
                                           FontSize="12"
                                           Opacity="0.7" />

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="Apply" Classes="pill-action emphasized" Click="OnApply" />
                                    <Button Content="Preview" Classes="pill-action emphasized" Click="OnPreview" />

                                    <Button Content="Display ⌄"
                                            Classes="pill-action"
                                            IsEnabled="{Binding CanChooseDisplay}">
                                        <Button.Flyout>
                                            <MenuFlyout ItemsSource="{Binding DisplayTargets}"
                                                        ItemContainerTheme="{StaticResource DisplayTargetMenuItemTheme}" />
                                        </Button.Flyout>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <Border.ContextFlyout>
                                <MenuFlyout>
                                    <MenuItem Header="Preview…" Click="OnPreview" />
                                    <MenuItem Header="Apply to All Displays" Click="OnApply" />
                                    <MenuItem Header="Apply to Display"
                                              IsEnabled="{Binding CanChooseDisplay}"
                                              ItemsSource="{Binding DisplayTargets}"
                                              ItemContainerTheme="{StaticResource DisplayTargetMenuItemTheme}" />
                                    <Separator />
                                    <MenuItem Header="Rename…" Click="OnRename" />
                                    <MenuItem Header="Delete…" Click="OnDelete" />
                                </MenuFlyout>
                            </Border.ContextFlyout>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Import tray: dropped files waiting for review. Nothing is copied
             into the library until the user confirms the batch. -->
        <StackPanel Grid.Row="1"
                    IsVisible="{Binding ImportQueue.HasItems}"
                    Spacing="10"
                    Margin="0,0,0,12">
            <Separator />

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="12,0">
                <TextBlock Grid.Column="0"
                           Text="{Binding ImportQueue.Title}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <ProgressBar Grid.Column="1"
                             Width="120"
                             Margin="10,0,0,0"
                             VerticalAlignment="Center"
                             Value="{Binding ImportQueue.ImportProgress}"
                             IsVisible="{Binding ImportQueue.IsImporting}" />

                <Button Grid.Column="3"
                        Content="Clear"
                        Classes="pill-action"
                        Margin="0,0,6,0"
                        Click="OnClearStaged" />

                <Button Grid.Column="4"
                        Content="{Binding ImportQueue.ImportTitle}"
                        Classes="accent"
                        FontSize="12"
                        IsEnabled="{Binding ImportQueue.CanImport}"
                        Click="OnConfirmImport" />
            </Grid>

            <!-- A fixed height keeps the tray a strip along the bottom: left to
                 size itself, the row would take the grid's space above it. -->
            <ScrollViewer Height="176"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding ImportQueue.Items}" Margin="12,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ImportItemViewModel">
                            <Border Width="172"
                                    Height="164"
                                    Padding="8"
                                    VerticalAlignment="Top"
                                    ClipToBounds="True"
                                    Classes="card">
                                <StackPanel Spacing="6">
                                    <Panel>
                                        <Border CornerRadius="8"
                                                ClipToBounds="True"
                                                Height="88"
                                                Background="{DynamicResource ControlAltFillColorTertiaryBrush}">
                                            <Panel>
                                                <TextBlock Text="🎞"
                                                           FontSize="22"
                                                           Opacity="0.45"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Image Source="{Binding Preview}" Stretch="UniformToFill" />

                                                <Panel Background="#59000000" IsVisible="{Binding IsBusy}">
                                                    <ProgressBar IsIndeterminate="True"
                                                                 Width="70"
                                                                 HorizontalAlignment="Center"
                                                                 VerticalAlignment="Center" />
                                                </Panel>

                                                <Panel Background="#59000000" IsVisible="{Binding IsImported}">
                                                    <TextBlock Text="✓"
                                                               FontSize="24"
                                                               Foreground="White"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Panel>

                                                <Panel Background="#59000000" IsVisible="{Binding HasProblem}">
                                                    <TextBlock Text="⚠"
                                                               FontSize="22"
                                                               Foreground="{DynamicResource BrandWaveOrangeBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Panel>
                                            </Panel>
                                        </Border>

                                        <Button Content="✕"
                                                Classes="icon-circle on-image compact"
                                                Margin="4"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                IsVisible="{Binding CanRemove}"
                                                ToolTip.Tip="Remove from this import"
                                                Click="OnRemoveStaged" />
                                    </Panel>

                                    <TextBlock Text="{Binding Name}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />

                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Classes="staged-detail"
                                               Classes.problem="{Binding HasProblem}"
                                               ToolTip.Tip="{Binding Subtitle}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <Separator Grid.Row="2" />

        <Grid Grid.Row="3" x:Name="Toolbar" ColumnDefinitions="*,Auto,Auto,Auto" Margin="12">
            <TextBlock Grid.Column="0"
                       Text="{Binding Coordinator.StatusMessage}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       Opacity="0.7" />

            <ProgressBar Grid.Column="1"
                         IsIndeterminate="True"
                         Width="90"
                         Margin="0,0,10,0"
                         VerticalAlignment="Center"
                         IsVisible="{Binding Coordinator.IsImporting}" />

            <Panel Grid.Column="2" x:Name="DropZone" Margin="0,0,10,0" VerticalAlignment="Center">
                <Rectangle x:Name="DropZoneOutline" Classes="drop-zone" />
                <TextBlock Text="Drop videos here"
                           FontSize="12"
                           Opacity="0.7"
                           Margin="14,7" />
            </Panel>

            <Button Grid.Column="3"
                    Content="Import Video…"
                    Classes="accent"
                    FontSize="12"
                    Click="OnImport"
                    IsEnabled="{Binding !Coordinator.IsImporting}" />
        </Grid>

        <!-- Drop target highlight -->
        <Border Grid.Row="0"
                x:Name="DropHighlight"
                IsVisible="False"
                IsHitTestVisible="False"
                Margin="8"
                CornerRadius="12"
                BorderThickness="3"
                BorderBrush="{StaticResource BrandWavePurpleBrush}" />
    </Grid>
</UserControl>
