<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Wallpache.App.ViewModels"
        xmlns:views="using:Wallpache.App.Views"
        mc:Ignorable="d" d:DesignWidth="820" d:DesignHeight="560"
        x:Class="Wallpache.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/wallpache.ico"
        Title="Wallpache"
        Width="820"
        Height="560"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource WindowBackgroundBrush}">

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Icon, name, and tagline, so the window reads as Wallpache rather
             than a generic tab bar. -->
        <Border Grid.Row="0"
                Padding="16,12"
                Background="{StaticResource BrandHeaderBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Source="avares://Wallpache/Assets/brand-mark.png" Width="40" Height="40" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Wallpache" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{StaticResource BrandTagline}" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Section switcher: a floating pill instead of a default tab strip,
             so the window opens with the same silhouette as the macOS app's
             title-bar switcher without touching Windows' own caption buttons.
             Sits under the header rather than above it. -->
        <Border Grid.Row="1"
                Margin="0,14,0,10"
                Padding="4"
                HorizontalAlignment="Center"
                CornerRadius="18"
                Background="{DynamicResource TabSwitcherBackgroundBrush}"
                BorderBrush="{DynamicResource TabSwitcherBorderBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="2">
                <RadioButton x:Name="TabLibrary"
                             GroupName="MainTabs"
                             Content="Library"
                             Classes="pill"
                             IsChecked="True" />
                <RadioButton x:Name="TabDisplays"
                             GroupName="MainTabs"
                             Content="Displays"
                             Classes="pill" />
                <RadioButton x:Name="TabSettings"
                             GroupName="MainTabs"
                             Content="Settings"
                             Classes="pill" />
            </StackPanel>
        </Border>

        <Rectangle Grid.Row="2" Height="2" Fill="{StaticResource BrandWaveBrush}" />

        <Grid Grid.Row="3">
            <views:LibraryView x:Name="Library" IsVisible="{Binding #TabLibrary.IsChecked}" />
            <views:DisplayConfigurationView IsVisible="{Binding #TabDisplays.IsChecked}" />
            <views:SettingsView IsVisible="{Binding #TabSettings.IsChecked}" />
        </Grid>
    </Grid>
</Window>
