<Project>
  <!--
    Visual Studio's Publish button (right-click the project > Publish, or the
    Publish toolbar item) reads this profile. It publishes self-contained
    win-x64 into apps\windows\build\publish - the same folder
    scripts\make-installer.ps1 and wallpache-installer.iss expect - so the
    BuildInstaller target in Wallpache.App.csproj fires afterward and drops
    WallpacheSetup-<Version>.exe into dist\.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\build\publish\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
